{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main LocalSync window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    "deep-link:default",
    "clipboard-manager:allow-write-text"
  ]
}
