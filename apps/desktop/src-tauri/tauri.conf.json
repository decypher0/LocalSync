{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalSync",
  "version": "0.1.0",
  "identifier": "dev.localsync.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LocalSync",
        "width": 1080,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/main.desktop",
        "postInstallScript": "./linux/postinst.sh",
        "postRemoveScript": "./linux/postrm.sh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGNzUzRTJEODUxNjcwREMKUldUY2NCYUZMVDUxditSTmlBVmxTNU1sUFREY1NXN3Rwb3dCVXpzNmlUdVFHd2YvR1hZcnBnK0wK",
      "endpoints": [
        "https://github.com/decypher0/LocalSync/releases/download/latest/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["localsync"]
      }
    }
  }
}
